<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional Claude Desktop managed preferences for OTLP export to a local collector.
  Docs: https://claude.com/docs/third-party/claude-desktop/configuration

  Install (GUI): open this file → System Settings → Privacy & Security → Profiles
  Or use your MDM to deploy PayloadType com.anthropic.claudefordesktop

  Note: consumer Claude Desktop builds primarily honor MDM / Admin Console keys.
  Code-tab sessions also pick up ~/.claude/settings.json env from scripts/install-global.sh.
-->
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key>
      <string>com.anthropic.claudefordesktop</string>
      <key>PayloadIdentifier</key>
      <string>com.example.claude.desktop.otel</string>
      <key>PayloadUUID</key>
      <string>7c2f9c1a-4e8b-4d3a-9f21-8a0b6d5e1c10</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadEnabled</key>
      <true/>
      <key>PayloadDisplayName</key>
      <string>Claude Desktop OpenTelemetry (local)</string>

      <key>otlpEndpoint</key>
      <string>http://127.0.0.1:4318</string>
      <key>otlpProtocol</key>
      <string>http/protobuf</string>
      <key>otlpDesktopLogLevel</key>
      <string>info</string>
      <key>otlpTracesEnabled</key>
      <true/>
      <key>otlpContentCapture</key>
      <array>
        <string>userPrompts</string>
        <string>assistantResponses</string>
        <string>toolDetails</string>
      </array>
      <key>otlpResourceAttributes</key>
      <dict>
        <key>deployment.environment</key>
        <string>local</string>
        <key>collector.stack</key>
        <string>claude-code-otel</string>
      </dict>
    </dict>
  </array>
  <key>PayloadDisplayName</key>
  <string>Claude Desktop OTel Local Stack</string>
  <key>PayloadIdentifier</key>
  <string>com.example.claude.desktop.otel.profile</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>b91a0e44-2f7d-4c1e-a8c3-0d5f6a7b8c9d</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
