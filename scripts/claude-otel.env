# Source this file or let install-global.sh append it to your shell profile.
# Docs: https://code.claude.com/docs/en/monitoring-usage

export CLAUDE_CODE_ENABLE_TELEMETRY=1

# Metrics + events (logs). Traces are beta — enabled below.
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_TRACES_EXPORTER=otlp
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1

export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Include user prompts (sensitive). Assistant responses follow this flag
# unless OTEL_LOG_ASSISTANT_RESPONSES is set explicitly.
export OTEL_LOG_USER_PROMPTS=1
export OTEL_LOG_ASSISTANT_RESPONSES=1
export OTEL_LOG_TOOL_DETAILS=1

# Faster feedback while validating the local stack
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_LOGS_EXPORT_INTERVAL=5000

# Helpful labels for filtering in Grafana / Postgres
export OTEL_RESOURCE_ATTRIBUTES=host.name=$(hostname),deployment.environment=local
