# Copy to .env and adjust before production use.
# These defaults are for local single-user development only.

POSTGRES_USER=claude
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=claude_otel

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_local_only

# Executive analytics UI (Next.js) — http://localhost:3010
ANALYTICS_PORT=3010
# ROI heuristic: estimated value = sessions × hours × hourly cost
AVG_HOURS_SAVED_PER_SESSION=0.5
HOURLY_ENGINEER_COST_USD=75

# Optional: override compose project name
COMPOSE_PROJECT_NAME=claude-code-otel
